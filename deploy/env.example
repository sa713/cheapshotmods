# Literal KEY=value, no shell quoting or interpolation. Keep chmod 600, outside Git.
PUBLIC_BASE_URL=https://mods.example.com
# Empty SESSION_SECRET is replaced with random 64 hexadecimal characters at install.
SESSION_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_OIDC_CLIENT_ID=
TELEGRAM_OIDC_CLIENT_SECRET=
# Existing local ports must be free. PUBLIC_BASE_URL port must match HTTPS port.
CHM_HTTP_PORT=80
CHM_HTTPS_PORT=443
CHM_BIND_ADDRESS=0.0.0.0
CADDY_EMAIL=operator@example.com
